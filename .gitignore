# Credentials — never commit
credentials.env
*.env

# Archives — handled by Retired folder; binary files add no git value
*.zip

# System files
.DS_Store
Thumbs.db

# Editor temp files
*.swp
*.swo
*~
.~lock.*#

# ClaudeIOS private files — uploaded to claude.ai project directly
ClaudeIOS/TrueState.md

# Python cache (grip renderer)
__pycache__/
*.pyc
wiki_src/

# Session close scratch file — ephemeral, created and deleted within each close, never canonical
Session/CLOSE_QUEUE.md

# Local-only working files — not canonical, not for git, not for wiki (Andy + agy, S134)
V1/_assets_local/

# Database backps — binary files that will bloat the repository
Database/db_backups/
*.sql.gz
